{
  "name": "desafio-qa-cpb",
  "version": "1.0.0",
  "private": true,
  "description": "Desafio Prático de QA do Comitê Paralímpico Brasileiro (CPB): avaliação do módulo de loja virtual de um fornecedor (automationexercise.com) com Playwright",
  "author": "Anderson Galvão",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "allure:generate": "allure generate allure-results --clean",
    "allure:open": "allure open allure-report",
    "allure": "npm run allure:generate && npm run allure:open"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "allure": "^3.33.0",
    "allure-playwright": "^3.15.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
